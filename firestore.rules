rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function email() { return request.auth.token.email.lower(); }
    function isAdmin() { return signedIn() && request.auth.token.email != null && email() == 'vlogselectroshial@gmail.com'; }
    function isPanelist() {
      return isAdmin() || (signedIn() && request.auth.token.email != null
        && exists(/databases/$(database)/documents/staff/$(email())));
    }
    function isMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.status == 'approved';
    }
    // a student whose ID is in the member list (and mobile or roll matches) is approved at once
    function rosterMatch(d) {
      let r = /databases/$(database)/documents/roster/$(d.sid);
      return exists(r) && (get(r).data.phone10 == d.phone10 || get(r).data.roll == d.roll);
    }

    // ---------- public pages ----------
    match /committee/{cid} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isPanelist()
        && get(/databases/$(database)/documents/staff/$(email())).data.cid == cid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photo', 'bio', 'phone', 'fb', 'skills', 'pop']));
    }
    match /gallery/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ---------- panelists (which email is which panelist) ----------
    match /staff/{k} {
      allow read: if isAdmin() || (signedIn() && request.auth.token.email != null && email() == k);
      allow write: if isAdmin();
    }

    // ---------- members ----------
    match /members/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isPanelist());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.id == uid
        && (request.resource.data.status == 'pending'
          || (request.resource.data.status == 'approved' && rosterMatch(request.resource.data)));
      allow update: if signedIn() && (isPanelist()
        || (request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photo', 'prog'])));
      allow delete: if isPanelist();
    }
    match /roster/{id} {
      allow read, write: if isPanelist();
    }

    // ---------- posts, notices, notifications ----------
    match /notices/{id} {
      allow read: if isPanelist() || isMember();
      allow create, delete: if isPanelist();
      allow update: if isPanelist() || (isMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'comments', 'shares']));
    }
    match /formal/{id} {
      allow read: if isPanelist() || isMember();
      allow write: if isPanelist();
    }
    match /notifs/{id} {
      allow create: if signedIn();
      allow read: if signedIn() && ((resource.data.to == 'p' && isPanelist()) || resource.data.to == request.auth.uid);
      allow update: if isPanelist() || (signedIn() && resource.data.to == request.auth.uid);
      allow delete: if isPanelist();
    }
  }
}
